{
  "expo": {
    "name": "Tornado",
    "slug": "tornado",
    "scheme": "tornado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content",
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tornado.app"
    },
    "android": {
      "package": "com.tornado.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f17"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7e6fd0"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 Tornado 访问麦克风以录制声音"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Tornado 访问相册以上传头像"
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://tornado.acgay.cn",
      "router": {},
      "eas": {
        "projectId": "50d39663-ed47-45f4-98a8-2f72fbb8350a"
      }
    }
  }
}
