{
  "expo": {
    "name": "Tornado",
    "slug": "tornado",
    "scheme": "tornado",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content",
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tornado.app"
    },
    "android": {
      "package": "com.tornado.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7e6fd0"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 Tornado 访问麦克风以录制声音"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Tornado 访问相册以上传头像"
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://10.21.41.53:3011"
    }
  }
}
